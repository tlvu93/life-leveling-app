  "version": "0.1.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "postinstall": "node scripts/setup-skia-web.mjs",
    "setup:skia-web": "node scripts/setup-skia-web.mjs",
    "start": "expo start --port 8085",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "pretest:e2e": "npm run export:web",
    "test:e2e": "playwright test",
    "serve:web:test": "node scripts/serve-dist-web.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "doctor": "npx expo-doctor@latest"
  },
  "private": true
}
